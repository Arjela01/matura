{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2017", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@msh/auth/feat-auth": ["libs/auth/feat-auth/src/index.ts"],
      "@msh/feat-admin-shell": ["libs/feat-admin-shell/src/index.ts"],
      "@msh/feat-dashboard": ["libs/feat-dashboard/src/index.ts"],
      "@msh/layout/ui-layout": ["libs/layout/ui-layout/src/index.ts"],
      "@msh/layout/util-layout": ["libs/layout/util-layout/src/index.ts"],
      "@msh/shared/assets": ["libs/shared/assets/src/index.ts"],
      "@msh/shared/data-access-shared": [
        "libs/shared/data-access-shared/src/index.ts"
      ],
      "@msh/shared/environments": ["libs/shared/environments/src/index.ts"],
      "@msh/shared/styles": ["libs/shared/styles/src/index.ts"],
      "@msh/shared/ui-shared": ["libs/shared/ui-shared/src/index.ts"],
      "@msh/shared/util-shared": ["libs/shared/util-shared/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
