{
  "name": "ui-configurations",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/configurations/ui-configurations/src",
  "prefix": "msh",
  "targets": {
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/configurations/ui-configurations/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/configurations/ui-configurations/**/*.ts",
          "libs/configurations/ui-configurations/**/*.html"
        ]
      }
    }
  },
  "tags": ["type:ui", "scope:configurations"]
}
