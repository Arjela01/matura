{
  "name": "data-access-layout",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/layout/data-access-layout/src",
  "prefix": "msh",
  "targets": {
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/layout/data-access-layout/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/layout/data-access-layout/**/*.ts",
          "libs/layout/data-access-layout/**/*.html"
        ]
      }
    }
  },
  "tags": ["type:data-access", "scope:configurations"]
}
