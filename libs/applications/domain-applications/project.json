{
  "name": "applications-domain-applications",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/applications/domain-applications/src",
  "prefix": "msh",
  "targets": {
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/applications/domain-applications/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/applications/domain-applications/**/*.ts",
          "libs/applications/domain-applications/**/*.html"
        ]
      }
    }
  },
  "tags": [
    "type:domain",
    "scope:applications"
  ]
}
