{
  "name": "applications-domain-application",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/applications/domain-application/src",
  "prefix": "msh",
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/applications/domain-application/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/applications/domain-application/**/*.ts",
          "libs/applications/domain-application/**/*.html"
        ]
      }
    }
  },
  "tags": ["type:domain", "scope:applications"]
}
